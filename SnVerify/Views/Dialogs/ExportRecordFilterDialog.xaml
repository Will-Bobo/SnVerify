<Window x:Class="SnVerify.Views.Dialogs.ExportRecordFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择导出内容"
        Width="360"
        Height="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="请选择本次导出的内容："
                   FontSize="13"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="1"
                Padding="8"
                Background="#F7F7F7"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,0,0,12">
            <StackPanel>
                <CheckBox x:Name="ChkSnMatch"
                          Content="SN 检验记录"
                          Margin="0,4"/>
                <CheckBox x:Name="ChkVersionMatch"
                          Content="版本检验记录"
                          Margin="0,4"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="BtnOk"
                    Content="确定"
                    IsDefault="True"
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Click="BtnOk_OnClick"/>
            <Button x:Name="BtnCancel"
                    Content="取消"
                    IsCancel="True"
                    MinWidth="80"
                    Click="BtnCancel_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
