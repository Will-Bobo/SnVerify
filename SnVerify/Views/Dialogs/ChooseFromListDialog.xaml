<Window x:Class="SnVerify.Views.Dialogs.ChooseFromListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择"
        Width="420"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 说明文字 -->
        <TextBlock x:Name="TxtInstruction"
                   Grid.Row="0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <!-- 搜索框（含灰色提示文字） -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <TextBox x:Name="TxtSearch"
                     Padding="6,4"
                     FontSize="13"
                     TabIndex="0"
                     KeyDown="TxtSearch_OnKeyDown"
                     TextChanged="TxtSearch_OnTextChanged"/>
            <TextBlock x:Name="TxtPlaceholder"
                       Text="输入关键字搜索..."
                       Foreground="#999999"
                       FontSize="13"
                       Padding="10,6,6,6"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <!-- 列表（垂直滚动条 Auto） -->
        <Border Grid.Row="2"
                Padding="0"
                Background="#F7F7F7"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,0,0,12">
            <ListBox x:Name="ListItems"
                     BorderThickness="0"
                     Background="Transparent"
                     TabIndex="1"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ListItems_OnSelectionChanged"
                     MouseDoubleClick="ListItems_OnMouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="MinHeight" Value="36"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- 操作按钮（Tab：确定 → 取消） -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="BtnOk"
                    Content="确定"
                    IsDefault="True"
                    MinWidth="80"
                    Margin="0,0,8,0"
                    TabIndex="2"
                    Click="BtnOk_OnClick"/>
            <Button x:Name="BtnCancel"
                    Content="取消"
                    IsCancel="True"
                    MinWidth="80"
                    TabIndex="3"
                    Click="BtnCancel_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
