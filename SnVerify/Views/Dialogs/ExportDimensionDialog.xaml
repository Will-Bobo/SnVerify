<Window x:Class="SnVerify.Views.Dialogs.ExportDimensionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择导出类型"
        Width="360"
        Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 说明文字 -->
        <TextBlock Grid.Row="0"
                   Text="请选择本次导出的类型："
                   FontSize="13"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <!-- 选项区域 -->
        <Border Grid.Row="1"
                Padding="8"
                Background="#F7F7F7"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,0,0,12">
            <StackPanel>
                <RadioButton x:Name="RadioByProject"
                             Content="按项目导出（包含项目下所有订单与会话）"
                             GroupName="ExportDimension"
                             IsChecked="True"
                             Margin="0,4"/>
                <RadioButton x:Name="RadioByOrder"
                             Content="按订单导出（仅导出所选订单）"
                             GroupName="ExportDimension"
                             Margin="0,4"/>
            </StackPanel>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="BtnOk"
                    Content="确定"
                    IsDefault="True"
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Click="BtnOk_OnClick"/>
            <Button x:Name="BtnCancel"
                    Content="取消"
                    IsCancel="True"
                    MinWidth="80"
                    Click="BtnCancel_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
