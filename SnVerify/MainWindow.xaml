<Window x:Class="SnVerify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SnVerify"
        mc:Ignorable="d"
        Title="Smartke SN校验程序" Height="800" Width="1300"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 工业上位机样式：简约、清晰、无装饰 -->
        
        <!-- 订单/测试区标题样式（阶段 3 C1.1：文案改为「本次测试」「当前订单」，不出现 SessionId/Session） -->
        <Style x:Key="BatchHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <!-- 主状态卡片样式：外框拟物（厚边框）、内层“状态灯”纯色块 -->
        <Style x:Key="ResultCardStyle" TargetType="Border">
            <!-- 外框：类似仪表盘卡槽，固定中性灰色 -->
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="20"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- 主状态文字样式：字号≥48，粗体，白色 -->
        <Style x:Key="ResultTextStyle" TargetType="TextBlock">
            <!-- 稍微缩小主状态字号，但仍≥48 -->
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- SN显示样式：字号≥20 -->
        <Style x:Key="SnDisplayStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <!-- 失败原因样式：字号≥16，整体更紧凑 -->
        <Style x:Key="FailReasonStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8B0000"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <!-- 减小外边距，避免占用过多高度 -->
            <Setter Property="Margin" Value="4,6,4,4"/>
        </Style>

        <!-- 错误详情面板样式：仅FAIL时显示，紧凑版 -->
        <Style x:Key="ErrorDetailPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFECEB"/>
            <Setter Property="BorderBrush" Value="#CC0000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowFailReason}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>
    
    <DockPanel LastChildFill="True">
        <!-- 1. 测试控制区（顶部，次要）- 阶段 3 C1.1：文案改为「本次测试」「当前订单」 -->
        <Grid DockPanel.Dock="Top" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- 测试控制区（Phase 2.5：ProjectId + OrderId 输入 + 本次测试标识只读展示） -->
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Background="#F5F5F5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="项目名：" Style="{StaticResource BatchHeaderStyle}" VerticalAlignment="Center" Padding="5,2"/>
                    <TextBox Grid.Column="1" x:Name="ProjectIdTextBox" MinWidth="120" Height="28" Margin="5,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                             Text="{Binding ProjectIdInput, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Background" Value="#E0E0E0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Grid.Column="2" Text="订单号：" Style="{StaticResource BatchHeaderStyle}" Margin="10,0,0,0" VerticalAlignment="Center" Padding="5,2"/>
                    <TextBox Grid.Column="3" x:Name="OrderIdTextBox" MinWidth="120" Height="28" Margin="5,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                             Text="{Binding OrderIdInput, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Background" Value="#E0E0E0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Grid.Column="4" Text="本次测试：" Style="{StaticResource BatchHeaderStyle}" Margin="10,0,0,0" VerticalAlignment="Center" Padding="5,2"/>
                    <TextBlock Grid.Column="5" x:Name="CurrentTestIdentifierText" MinWidth="150" Height="28" Margin="5,0" VerticalAlignment="Center"
                               Text="{Binding CurrentTestIdentifier}" FontSize="12" Foreground="#666666"
                               Background="#F0F0F0" Padding="5,2">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="--"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTestIdentifier}" Value="">
                                        <Setter Property="Text" Value="--"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="6" x:Name="StartBatchButton" Content="开始测试" Width="100" Height="28" Margin="5,0" VerticalAlignment="Center"
                            Command="{Binding StartBatchCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="7" x:Name="EndBatchButton" Content="结束测试" Width="100" Height="28" Margin="5,0" VerticalAlignment="Center"
                            Command="{Binding EndBatchCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="8" x:Name="ExportBatchButton" Content="导出" Width="80" Height="28" Margin="5,0" VerticalAlignment="Center"
                            Command="{Binding ExportCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSessionActive}" Value="False">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- 6. 全局状态栏（窗口最底部，固定显示）- Phase 2.5：绑定 CurrentOrderId（来自 SessionSnapshot.OrderId） -->
        <StatusBar DockPanel.Dock="Bottom" Height="28" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentOrderId, StringFormat='当前订单: {0}'}" FontSize="12"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding IsProcessing, StringFormat='处理中: {0}'}" FontSize="12"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText, StringFormat='最近结果: {0}'}" FontSize="12"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="12" Foreground="#666666"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 5. 日志/测试记录区（默认折叠；展开时不应挤占掉底部状态栏） -->
        <Expander x:Name="DebugLogExpander"
                  DockPanel.Dock="Bottom"
                  Header="调试日志（Debug）"
                  IsExpanded="False"
                  Margin="5"
                  MaxHeight="260">
            <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="5" Background="White">
                <ListBox ItemsSource="{Binding UiLogs}" 
                         FontFamily="Consolas" 
                         FontSize="12" 
                         MinHeight="150"
                         MaxHeight="300"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Background="White"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Expander>

        <!-- 2. 主检验区（中部，核心区域，高度≥60%，最小高度保证主卡片不被挤占） -->
        <Grid Margin="10" MinHeight="500">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 主检验显示区域 -->
            <Border Grid.Column="0" BorderBrush="#999999" BorderThickness="1" Padding="30" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 主状态卡片行，设置较小的最小高度，便于整体紧凑 -->
                        <RowDefinition Height="*" MinHeight="260"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 当前SN显示（大字号，清晰可见） -->
                    <!-- <Border Grid.Row="0" Margin="0,0,0,20" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="当前SN" FontSize="16" FontWeight="Bold" Foreground="#666666" 
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock MinWidth="400" MaxWidth="600">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SnDisplayStyle}">
                                        <Setter Property="Text" Value="{Binding CurrentSn}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSn}" Value="">
                                                <Setter Property="Text" Value=""/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border> -->
                    
                    <!-- 主状态卡片（居中，拟物风格：外框 + 内部状态灯） -->
                    <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- 外框：中性灰色厚边框，类似设备面板上的卡槽 -->
                        <Border Style="{StaticResource ResultCardStyle}" 
                                Width="320" Height="320"
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 顶部小标题：当前状态 -->
                                <TextBlock Grid.Row="0"
                                           Text="当前状态"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#555555"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>

                                <!-- 内部状态灯：纯色矩形块，强状态色 -->
                                <Border Grid.Row="1"
                                        CornerRadius="10"
                                        Padding="20"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- 默认：空闲灰 -->
                                            <Setter Property="Background" Value="#808080"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UiState}" Value="Pass">
                                                    <Setter Property="Background" Value="#00CC00"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UiState}" Value="Fail">
                                                    <Setter Property="Background" Value="#FF0000"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UiState}" Value="Processing">
                                                    <Setter Property="Background" Value="#0080FF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UiState}" Value="Idle">
                                                    <Setter Property="Background" Value="#808080"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <!-- 中心大号状态文本 -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ResultTextStyle}">
                                                    <Setter Property="Text" Value="等待扫码"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UiState}" Value="Pass">
                                                            <Setter Property="Text" Value="PASS"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UiState}" Value="Fail">
                                                            <Setter Property="Text" Value="FAIL"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UiState}" Value="Processing">
                                                            <Setter Property="Text" Value="检验中..."/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UiState}" Value="Idle">
                                                            <Setter Property="Text" Value="等待扫码"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 英文状态码（次要，但有利于调试/对接） -->
                                        <TextBlock Margin="0,8,0,0"
                                                   FontSize="16"
                                                   Foreground="#F0F0F0"
                                                   Opacity="0.9"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="WAITING"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UiState}" Value="Pass">
                                                            <Setter Property="Text" Value="PASS"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UiState}" Value="Fail">
                                                            <Setter Property="Text" Value="FAIL"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UiState}" Value="Processing">
                                                            <Setter Property="Text" Value="PROCESSING"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UiState}" Value="Idle">
                                                            <Setter Property="Text" Value="WAITING"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 扫码输入框（弱化样式，位于主状态卡片与 SN 信息之间） -->
                    <Border Grid.Row="2"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0"
                            Background="#F0F0F0"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Padding="8,4"
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="扫码：" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#666666"/>
                            <TextBox x:Name="ScanInputTextBox" Width="260" Height="26" Margin="0"
                                     Text="{Binding ScanInputText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="ScanInputTextBox_KeyDown"
                                     GotFocus="ScanInputTextBox_GotFocus"
                                     FontSize="14"
                                     Background="White"
                                     BorderBrush="#999999"
                                     BorderThickness="1">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="IsEnabled" Value="{Binding IsScanInputEnabled}"/>
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanInputEnabled}" Value="False">
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>
                    </Border>

                    <!-- SN信息显示（扫码SN和设备SN） - 高度与字体进一步收紧 -->
                    <Border Grid.Row="3" 
                            Background="#F8F8F8" 
                            BorderBrush="#DDDDDD" 
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,4"
                            Margin="0,8,0,4"
                            HorizontalAlignment="Center"
                            Width="680">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 扫码SN -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="扫码SN" 
                                           FontSize="12" 
                                           FontWeight="Bold"
                                           Foreground="#666666"
                                           Margin="0,0,0,2"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentSn}" 
                                           FontSize="18" 
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="--"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentSn}" Value="">
                                                    <Setter Property="Text" Value="--"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <!-- 分隔线 -->
                            <Rectangle Grid.Column="1" Width="1" 
                                       Fill="#DDDDDD" 
                                       VerticalAlignment="Stretch" 
                                       Margin="0,2"/>
                            <!-- 设备SN -->
                            <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                <TextBlock Text="设备SN" 
                                           FontSize="12" 
                                           FontWeight="Bold"
                                           Foreground="#666666"
                                           Margin="0,0,0,2"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding DeviceSN}" 
                                           FontSize="18" 
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="--"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeviceSN}" Value="">
                                                    <Setter Property="Text" Value="--"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 失败原因显示（仅FAIL时显示，区域更紧凑） -->
                    <Grid Grid.Row="4" MinHeight="40" Margin="0,6,0,6">
                        <Border Style="{StaticResource ErrorDetailPanelStyle}">
                            <TextBlock Text="{Binding FailReason}" Style="{StaticResource FailReasonStyle}"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. 辅助功能区（右侧：人工检验、自检） -->
            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Top">
                <Button x:Name="StartVerifyButton" Content="人工检验" Width="120" Height="45" Margin="0,5"
                        Command="{Binding StartVerifyCommand}"
                        Click="StartVerifyButton_Click"
                        FontSize="14" FontWeight="Bold"/>
                <Button x:Name="SelfCheckButton" Content="自检" Width="120" Height="45" Margin="0,5"
                        Command="{Binding SelfCheckCommand}"
                        Click="SelfCheckButton_Click"
                        FontSize="14" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
