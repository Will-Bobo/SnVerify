<Window x:Class="SnVerify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SnVerify"
        mc:Ignorable="d"
        Title="Smartke SN校验程序" Height="800" Width="1300"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 转换器 -->
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        
        <!-- 样式定义 -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 结果卡片样式：四角圆角 + 轻量投影 -->
        <Style x:Key="ResultCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="40,30"/>
            <Setter Property="Margin" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.4" Color="Black"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UiState}" Value="Pass">
                    <Setter Property="Background" Value="#2E7D32"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding UiState}" Value="Fail">
                    <Setter Property="Background" Value="#C62828"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding UiState}" Value="Processing">
                    <Setter Property="Background" Value="#1976D2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding UiState}" Value="Idle">
                    <Setter Property="Background" Value="#757575"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 结果文字样式 -->
        <Style x:Key="ResultTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="64"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- 错误详情面板样式 -->
        <Style x:Key="ErrorDetailPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFEBEE"/>
            <Setter Property="BorderBrush" Value="#EF5350"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Width" Value="500"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowFailReason}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 批次区 -->
            <RowDefinition Height="*"/> <!-- 检验区 -->
            <RowDefinition Height="Auto"/> <!-- 调试日志区 -->
            <RowDefinition Height="Auto"/> <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- 批次区 -->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="批次号：" Style="{StaticResource HeaderTextStyle}" VerticalAlignment="Center"/>
                <TextBox x:Name="BatchIdTextBox" MinWidth="200" Margin="5" VerticalAlignment="Center"
                         Text="{Binding BatchNameInput, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBatchActive}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button x:Name="StartBatchButton" Content="开始" Width="100" Margin="5"
                        Command="{Binding StartBatchCommand}"/>
                <Button x:Name="EndBatchButton" Content="结束" Width="100" Margin="5"
                        Command="{Binding EndBatchCommand}"/>
                <Button x:Name="ExportBatchButton" Content="导出" Width="80" Margin="5"
                        Command="{Binding ExportCommand}"/>
                <TextBlock x:Name="BatchStatusText" Margin="10,0" VerticalAlignment="Center"
                           Text="{Binding IsBatchActive, StringFormat='状态: {0}'}"/>
            </StackPanel>
        </Border>

        <!-- 检验区 -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 主检验区域 -->
            <Border Grid.Column="0" BorderBrush="DarkBlue" BorderThickness="2" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 检验状态标题 -->
                    <TextBlock Grid.Row="0" Text="检验结果" Style="{StaticResource HeaderTextStyle}"/>
                    
                    <!-- 中间区域：包含正方形卡片、SN信息显示、错误详情面板 -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 正方形中间区域：结果卡片（四角圆角、轻量投影） -->
                        <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource ResultCardStyle}" 
                                    Width="350" Height="350"
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ResultTextStyle}">
                                            <Setter Property="Text" Value="等待扫码"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UiState}" Value="Pass">
                                                    <Setter Property="Text" Value="PASS"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UiState}" Value="Fail">
                                                    <Setter Property="Text" Value="FAIL"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UiState}" Value="Processing">
                                                    <Setter Property="Text" Value="检验中..."/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UiState}" Value="Idle">
                                                    <Setter Property="Text" Value="等待扫码"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <!-- SN信息显示区域（扫码SN和设备SN，固定宽度，超长省略） -->
                        <Border Grid.Row="1" 
                                Background="#F5F5F5" 
                                BorderBrush="#E0E0E0" 
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="15,10"
                                Margin="20,10"
                                HorizontalAlignment="Center"
                                Width="680">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 扫码SN -->
                                <StackPanel Grid.Column="0" Margin="0,0,20,0" HorizontalAlignment="Stretch">
                                    <TextBlock Text="扫码SN" 
                                               FontSize="14" 
                                               FontWeight="Bold"
                                               Foreground="#666666"
                                               Margin="0,0,0,5"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentSn}" 
                                               FontSize="16" 
                                               Foreground="#424242"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="--"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentSn}" Value="">
                                                        <Setter Property="Text" Value="--"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <!-- 分隔线 -->
                                <Rectangle Grid.Column="1" Width="1" 
                                           Fill="#E0E0E0" 
                                           VerticalAlignment="Stretch" 
                                           Margin="0,5"/>
                                <!-- 设备SN -->
                                <StackPanel Grid.Column="2" Margin="20,0,0,0" HorizontalAlignment="Stretch">
                                    <TextBlock Text="设备SN" 
                                               FontSize="14" 
                                               FontWeight="Bold"
                                               Foreground="#666666"
                                               Margin="0,0,0,5"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding DeviceSN}" 
                                               FontSize="16" 
                                               Foreground="#424242"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="--"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeviceSN}" Value="">
                                                        <Setter Property="Text" Value="--"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 错误详情面板（固定区域，避免跳动） -->
                        <Grid Grid.Row="3" MinHeight="100" Margin="0,10,0,10">
                            <Border Style="{StaticResource ErrorDetailPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="错误详情" FontSize="14" FontWeight="Bold" 
                                               Foreground="#C62828" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding FailReason}" 
                                               FontSize="13" 
                                               Foreground="#424242"
                                               TextWrapping="Wrap"
                                               LineHeight="20"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 扫码输入框（核心交互控件） -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                        <TextBlock Text="扫码输入：" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="ScanInputTextBox" Width="300" Height="35" Margin="5"
                                 Text="{Binding ScanInputText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="ScanInputTextBox_KeyDown"
                                 GotFocus="ScanInputTextBox_GotFocus"
                                 FontSize="16">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧按钮区域 -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                <Button x:Name="StartVerifyButton" Content="人工检验" Width="120" Height="40" Margin="5"
                        Command="{Binding StartVerifyCommand}"
                        IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
                        Click="StartVerifyButton_Click"/>
                <Button x:Name="SelfCheckButton" Content="自检" Width="120" Height="40" Margin="5"
                        Command="{Binding SelfCheckCommand}"
                        Click="SelfCheckButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- 调试日志区域（可折叠，在状态栏上方） -->
        <Expander x:Name="DebugLogExpander" Grid.Row="2" Header="调试日志（Debug）" IsExpanded="False" Margin="5">
            <Border BorderBrush="Gray" BorderThickness="1" Padding="5">
                <ListBox ItemsSource="{Binding UiLogs}" 
                         FontFamily="Consolas" 
                         FontSize="12" 
                         MinHeight="150"
                         MaxHeight="300"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Expander>

        <!-- 状态栏（窗口最底部，不被日志遮挡） -->
        <StatusBar Grid.Row="3" Height="30">
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentBatchId, StringFormat='批次: {0}'}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding IsProcessing, StringFormat='处理中: {0}'}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText, StringFormat='最近结果: {0}'}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
