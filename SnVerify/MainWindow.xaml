<Window x:Class="SnVerify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SnVerify"
        mc:Ignorable="d"
        Title="Smartke SN校验程序" Height="800" Width="1300"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 转换器 -->
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        
        <!-- 样式定义 -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 批次区 -->
            <RowDefinition Height="*"/> <!-- 检验区 -->
            <RowDefinition Height="Auto"/> <!-- 调试日志区 -->
            <RowDefinition Height="Auto"/> <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- 批次区 -->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="批次号：" Style="{StaticResource HeaderTextStyle}" VerticalAlignment="Center"/>
                <TextBox x:Name="BatchIdTextBox" MinWidth="200" Margin="5" VerticalAlignment="Center"
                         Text="{Binding BatchNameInput, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBatchActive}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button x:Name="StartBatchButton" Content="开始批次" Width="100" Margin="5"
                        Command="{Binding StartBatchCommand}"/>
                <Button x:Name="EndBatchButton" Content="结束批次" Width="100" Margin="5"
                        Command="{Binding EndBatchCommand}"/>
                <Button x:Name="ExportBatchButton" Content="导出" Width="80" Margin="5"
                        Command="{Binding ExportCommand}"/>
                <TextBlock x:Name="BatchStatusText" Margin="10,0" VerticalAlignment="Center"
                           Text="{Binding IsBatchActive, StringFormat='状态: {0}'}"/>
            </StackPanel>
        </Border>

        <!-- 检验区 -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 主检验区域 -->
            <Border Grid.Column="0" BorderBrush="DarkBlue" BorderThickness="2" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 检验状态显示 -->
                    <TextBlock Grid.Row="0" Text="检验状态" Style="{StaticResource HeaderTextStyle}"/>
                    
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <!-- 状态显示（核心区域，操作员需要远看能分辨） -->
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="{Binding StatusText}"
                                   FontSize="48"
                                   FontWeight="Bold"
                                   Margin="20"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="Gray"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusText}" Value="PASS">
                                            <Setter Property="Foreground" Value="Green"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusText}" Value="FAIL">
                                            <Setter Property="Foreground" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusText}" Value="正在检验...">
                                            <Setter Property="Foreground" Value="Blue"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        
                        <!-- 当前 SN 显示（辅助信息） -->
                        <TextBlock x:Name="CurrentSnText" 
                                   Text="{Binding CurrentSn, StringFormat='当前 SN: {0}'}"
                                   FontSize="18" Margin="10" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSn}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentSn}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        
                        <!-- 失败原因（仅在 FAIL 时显示） -->
                        <TextBlock x:Name="FailReasonText"
                                   Text="{Binding FailReason, StringFormat='失败原因: {0}'}"
                                   FontSize="16" Margin="10" HorizontalAlignment="Center"
                                   Foreground="Red">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowFailReason}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- 扫码输入框（核心交互控件） -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                        <TextBlock Text="扫码输入：" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="ScanInputTextBox" Width="300" Height="35" Margin="5"
                                 Text="{Binding ScanInputText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="ScanInputTextBox_KeyDown"
                                 GotFocus="ScanInputTextBox_GotFocus"
                                 FontSize="16">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧按钮区域 -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                <Button x:Name="StartVerifyButton" Content="开始检验" Width="120" Height="40" Margin="5"
                        Command="{Binding StartVerifyCommand}"
                        IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"/>
                <Button x:Name="SelfCheckButton" Content="自检" Width="120" Height="40" Margin="5"
                        Command="{Binding SelfCheckCommand}"/>
            </StackPanel>
        </Grid>

        <!-- 调试日志区域（可折叠，在状态栏上方） -->
        <Expander Grid.Row="2" Header="调试日志（Debug）" IsExpanded="False" Margin="5">
            <Border BorderBrush="Gray" BorderThickness="1" Padding="5">
                <ListBox ItemsSource="{Binding UiLogs}" 
                         FontFamily="Consolas" 
                         FontSize="12" 
                         MinHeight="150"
                         MaxHeight="300"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Expander>

        <!-- 状态栏（窗口最底部，不被日志遮挡） -->
        <StatusBar Grid.Row="3" Height="30">
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentBatchId, StringFormat='批次: {0}'}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding IsProcessing, StringFormat='处理中: {0}'}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText, StringFormat='最近结果: {0}'}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
