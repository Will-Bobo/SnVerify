<Window x:Class="SnVerify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SnVerify"
        mc:Ignorable="d"
        Title="Smartke SN校验程序" Height="900" Width="1300"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:VerificationTypeToVisibilityConverter x:Key="VerificationTypeToVisibilityConverter"/>
        <local:VerificationTypeToDisplayConverter x:Key="VerificationTypeToDisplayConverter"/>
        <!-- 工业上位机样式：简约、清晰、无装饰 -->
        
        <!-- 订单/测试区标题样式（阶段 3 C1.1：文案改为「本次测试」「当前订单」，不出现 SessionId/Session） -->
        <Style x:Key="BatchHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <!-- 主状态卡片样式：外框拟物（厚边框）、内层“状态灯”纯色块 -->
        <Style x:Key="ResultCardStyle" TargetType="Border">
            <!-- 外框：类似仪表盘卡槽，固定中性灰色 -->
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="20"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- 主状态文字样式：字号≥48，粗体，白色 -->
        <Style x:Key="ResultTextStyle" TargetType="TextBlock">
            <!-- 稍微缩小主状态字号，但仍≥48 -->
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- SN显示样式：字号≥20 -->
        <Style x:Key="SnDisplayStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <!-- 失败原因样式：字号≥16，整体更紧凑 -->
        <Style x:Key="FailReasonStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8B0000"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <!-- 减小外边距，避免占用过多高度 -->
            <Setter Property="Margin" Value="4,6,4,4"/>
        </Style>

        <!-- 错误详情面板样式：仅FAIL时显示，紧凑版 -->
        <Style x:Key="ErrorDetailPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFECEB"/>
            <Setter Property="BorderBrush" Value="#CC0000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowFailReason}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>
    
    <DockPanel LastChildFill="True">
        <!-- 1. 测试控制区（顶部，次要）- 阶段 3 C1.1：文案改为「本次测试」「当前订单」 -->
        <Grid DockPanel.Dock="Top" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- 测试控制区（Phase 2.5：ProjectId + OrderId 输入 + 本次测试标识只读展示） -->
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Background="#F5F5F5">
                <!-- 测试控制区：单行布局（项目类型 + 项目信息 + 检验类型 + 操作按钮） -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Row="0" Grid.Column="0" LastChildFill="False" VerticalAlignment="Center">
                        <!-- 项目类型（原 产品代码，仅改文案） -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <TextBlock Text="项目类型：" Style="{StaticResource BatchHeaderStyle}" VerticalAlignment="Center" Padding="5,2"/>
                            <ComboBox Height="28" Margin="5,0,10,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding AvailableProducts}"
                                      SelectedItem="{Binding SelectedProductCode, Mode=TwoWay}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProductCodeComboBoxEnabled}" Value="False">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </StackPanel>

                        <!-- 项目名 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <TextBlock Text="项目名：" Style="{StaticResource BatchHeaderStyle}" VerticalAlignment="Center" Padding="5,2"/>
                            <TextBox x:Name="ProjectIdTextBox" MinWidth="120" Height="28" Margin="5,0,10,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     Text="{Binding ProjectIdInput, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>

                        <!-- 订单号 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <TextBlock Text="订单号：" Style="{StaticResource BatchHeaderStyle}" VerticalAlignment="Center" Padding="5,2"/>
                            <TextBox x:Name="OrderIdTextBox" MinWidth="120" Height="28" Margin="5,0,10,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     Text="{Binding OrderIdInput, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>

                        <!-- 检验类型（仅老产品显示） -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <TextBlock Text="检验类型：" Style="{StaticResource BatchHeaderStyle}" Margin="10,0,0,0" VerticalAlignment="Center" Padding="5,2"
                                       Visibility="{Binding IsLegacyProduct, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <ComboBox x:Name="VerificationTypeComboBox" MinWidth="100" Height="28" Margin="5,0,10,0" VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      ItemsSource="{Binding AvailableVerificationTypes}"
                                      SelectedItem="{Binding CurrentVerificationType, Mode=TwoWay}"
                                      Visibility="{Binding IsLegacyProduct, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVerificationTypeComboBoxEnabled}" Value="False">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource VerificationTypeToDisplayConverter}}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </StackPanel>

                        <!-- 操作按钮组 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0" DockPanel.Dock="Right">
                            <Button x:Name="StartBatchButton" Content="开始测试" Width="100" Height="28" Margin="5,0" VerticalAlignment="Center"
                                    Command="{Binding StartBatchCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="EndBatchButton" Content="结束测试" Width="100" Height="28" Margin="5,0" VerticalAlignment="Center"
                                    Command="{Binding EndBatchCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                                                <Setter Property="IsEnabled" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="ExportBatchButton" Content="导出" Width="80" Height="28" Margin="5,0" VerticalAlignment="Center"
                                    Command="{Binding ExportCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSessionActive}" Value="False">
                                                <Setter Property="IsEnabled" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 6. 全局状态栏（窗口最底部，固定显示）- Phase 2.5：绑定 CurrentOrderId（来自 SessionSnapshot.OrderId） -->
        <StatusBar DockPanel.Dock="Bottom" Height="28" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentOrderId, StringFormat='当前订单: {0}'}" FontSize="12"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding IsProcessing, StringFormat='处理中: {0}'}" FontSize="12"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText, StringFormat='最近结果: {0}'}" FontSize="12"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="12" Foreground="#666666"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 5. 日志/测试记录区（默认折叠；展开时不应挤占掉底部状态栏） -->
        <Expander x:Name="DebugLogExpander"
                  DockPanel.Dock="Bottom"
                  Header="调试日志（Debug）"
                  IsExpanded="False"
                  Margin="5"
                  MaxHeight="260"
                  Expanded="DebugLogExpander_Expanded">
            <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="5" Background="White">
                <ListBox x:Name="DebugLogListBox" ItemsSource="{Binding UiLogs}" 
                         FontFamily="Consolas" 
                         FontSize="12" 
                         MinHeight="150"
                         MaxHeight="300"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Background="White"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Expander>

        <!-- 2. 主检验区（中部，核心区域，高度≥60%，最小高度保证主卡片不被挤占） -->
        <Grid Margin="10" MinHeight="500">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 主检验显示区域 -->
            <Border Grid.Column="0" BorderBrush="#999999" BorderThickness="1" Padding="30" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>               <!-- Row0 SN -->
                        <RowDefinition Height="*" MinHeight="260"/>  <!-- Row1 状态卡片 -->
                        <RowDefinition Height="Auto"/>               <!-- Row2 输入区 -->
                        <RowDefinition Height="Auto"/>               <!-- Row3 SN/版本信息 -->
                        <RowDefinition Height="Auto"/>               <!-- Row4 KM001目标版本 -->
                        <RowDefinition Height="Auto"/>               <!-- Row5 KM001设备信息 -->
                        <RowDefinition Height="Auto"/>               <!-- Row6 FailReason -->
                    </Grid.RowDefinitions>

                    <!-- 当前SN显示（大字号，清晰可见） -->
                    <!-- <Border Grid.Row="0" Margin="0,0,0,20" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="当前SN" FontSize="16" FontWeight="Bold" Foreground="#666666" 
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock MinWidth="400" MaxWidth="600">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SnDisplayStyle}">
                                        <Setter Property="Text" Value="{Binding CurrentSn}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSn}" Value="">
                                                <Setter Property="Text" Value=""/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border> -->
                    
                    <!-- 主状态卡片（居中，拟物风格：外框 + 内部状态灯） -->
                    <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- 外框：中性灰色厚边框，类似设备面板上的卡槽 -->
                        <Border Style="{StaticResource ResultCardStyle}" 
                                Width="320" Height="320"
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 顶部小标题：当前状态 -->
                                <TextBlock Grid.Row="0"
                                           Text="当前状态"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#555555"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>

                                <!-- 内部状态灯：纯色矩形块，强状态色 -->
                                <Border Grid.Row="1"
                                        CornerRadius="10"
                                        Padding="20"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- 默认：空闲灰 -->
                                            <Setter Property="Background" Value="#808080"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UiState}" Value="Pass">
                                                    <Setter Property="Background" Value="#00CC00"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UiState}" Value="Fail">
                                                    <Setter Property="Background" Value="#FF0000"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UiState}" Value="Processing">
                                                    <Setter Property="Background" Value="#0080FF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UiState}" Value="Idle">
                                                    <Setter Property="Background" Value="#808080"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <!-- 中心大号状态文本 -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ResultTextStyle}">
                                                    <Setter Property="Text" Value="等待扫码"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UiState}" Value="Pass">
                                                            <Setter Property="Text" Value="PASS"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UiState}" Value="Fail">
                                                            <Setter Property="Text" Value="FAIL"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UiState}" Value="Processing">
                                                            <Setter Property="Text" Value="检验中..."/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UiState}" Value="Idle">
                                                            <Setter Property="Text" Value="等待扫码"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 英文状态码（次要，但有利于调试/对接） -->
                                        <TextBlock Margin="0,8,0,0"
                                                   FontSize="16"
                                                   Foreground="#F0F0F0"
                                                   Opacity="0.9"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="WAITING"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UiState}" Value="Pass">
                                                            <Setter Property="Text" Value="PASS"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UiState}" Value="Fail">
                                                            <Setter Property="Text" Value="FAIL"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UiState}" Value="Processing">
                                                            <Setter Property="Text" Value="PROCESSING"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UiState}" Value="Idle">
                                                            <Setter Property="Text" Value="WAITING"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 扫码输入框（VerificationType==SnMatch 时显示） -->
                    <Border Grid.Row="2"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0"
                            Background="#F0F0F0"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Padding="8,4"
                            CornerRadius="4"
                            Visibility="{Binding IsScanInputVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="扫码：" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#666666"/>
                            <TextBox x:Name="ScanInputTextBox" Width="260" Height="26" Margin="0"
                                     Text="{Binding ScanInputText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="ScanInputTextBox_KeyDown"
                                     GotFocus="ScanInputTextBox_GotFocus"
                                     FontSize="14"
                                     Background="White"
                                     BorderBrush="#999999"
                                     BorderThickness="1">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="IsEnabled" Value="{Binding IsScanInputEnabled}"/>
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanInputEnabled}" Value="False">
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>
                    </Border>

                    <!-- 版本输入框 + 版本检验按钮（VerificationType==VersionMatch 时显示，与扫码输入框同位置同样式） -->
                    <Border Grid.Row="2"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0"
                            Background="#F0F0F0"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Padding="8,4"
                            CornerRadius="4"
                            Visibility="{Binding IsVersionInputVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="目标版本：" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#666666"/>
                            <TextBox x:Name="TargetVersionTextBox" Width="200" Height="26" Margin="0,0,8,0"
                                     Text="{Binding TargetVersionInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14"
                                     Background="White"
                                     BorderBrush="#999999"
                                     BorderThickness="1">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="IsEnabled" Value="{Binding IsScanInputEnabled}"/>
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanInputEnabled}" Value="False">
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Button x:Name="StartVersionVerifyButton" Content="版本检验" Width="100" Height="26" Margin="0"
                                    Command="{Binding StartVersionVerifyCommand}"
                                    FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- SN信息显示（VerificationType==SnMatch 时显示）
                         - 非KM001：仅显示 扫码SN / 设备SN（居中，无空白占位）
                         - KM001：显示 扫码SN / 设备SN / 芯片ID / MAC -->
                    <Border Grid.Row="3" 
                            Background="#F8F8F8" 
                            BorderBrush="#DDDDDD" 
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,4"
                            Margin="0,8,0,4"
                            HorizontalAlignment="Center"
                            Width="680"
                            Visibility="{Binding IsSnInfoVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <!-- Grid A：通用项目类型（非KM001），仅显示 扫码SN / 设备SN -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPhase3Product}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>    <!-- 扫码SN -->
                                    <ColumnDefinition Width="Auto"/> <!-- 分隔线 -->
                                    <ColumnDefinition Width="*"/>    <!-- 设备SN -->
                                </Grid.ColumnDefinitions>

                                <!-- 扫码SN -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="扫码SN" 
                                               FontSize="12" 
                                               FontWeight="Bold"
                                               Foreground="#666666"
                                               Margin="0,0,0,2"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentSn}" 
                                               FontSize="18" 
                                               Foreground="#333333"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="--"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentSn}" Value="">
                                                        <Setter Property="Text" Value="--"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 分隔线 -->
                                <Rectangle Grid.Column="1" Width="1" 
                                           Fill="#DDDDDD" 
                                           VerticalAlignment="Stretch" 
                                           Margin="0,2"/>

                                <!-- 设备SN -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="设备SN" 
                                               FontSize="12" 
                                               FontWeight="Bold"
                                               Foreground="#666666"
                                               Margin="0,0,0,2"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding DeviceSN}" 
                                               FontSize="18" 
                                               Foreground="#333333"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="--"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeviceSN}" Value="">
                                                        <Setter Property="Text" Value="--"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- Grid B：KM001 项目类型（IsPhase3Product==true），显示 扫码SN / 设备SN / 芯片ID / MAC -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPhase3Product}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>    <!-- 0: 扫码SN -->
                                    <ColumnDefinition Width="Auto"/> <!-- 1: 分隔线 -->
                                    <ColumnDefinition Width="*"/>    <!-- 2: 设备SN -->
                                    <ColumnDefinition Width="Auto"/> <!-- 3: 分隔线 -->
                                    <ColumnDefinition Width="*"/>    <!-- 4: 芯片ID -->
                                    <ColumnDefinition Width="Auto"/> <!-- 5: 分隔线 -->
                                    <ColumnDefinition Width="*"/>    <!-- 6: MAC地址 -->
                                </Grid.ColumnDefinitions>

                                <!-- 扫码SN -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="扫码SN" 
                                               FontSize="12" 
                                               FontWeight="Bold"
                                               Foreground="#666666"
                                               Margin="0,0,0,2"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentSn}" 
                                               FontSize="18" 
                                               Foreground="#333333"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="--"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentSn}" Value="">
                                                        <Setter Property="Text" Value="--"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 分隔线 -->
                                <Rectangle Grid.Column="1" Width="1" 
                                           Fill="#DDDDDD" 
                                           VerticalAlignment="Stretch" 
                                           Margin="0,2"/>

                                <!-- 设备SN -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="设备SN" 
                                               FontSize="12" 
                                               FontWeight="Bold"
                                               Foreground="#666666"
                                               Margin="0,0,0,2"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding DeviceSN}" 
                                               FontSize="18" 
                                               Foreground="#333333"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="--"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeviceSN}" Value="">
                                                        <Setter Property="Text" Value="--"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 分隔线 -->
                                <Rectangle Grid.Column="3" Width="1"
                                           Fill="#DDDDDD"
                                           VerticalAlignment="Stretch"
                                           Margin="0,2"/>

                                <!-- 芯片ID -->
                                <StackPanel Grid.Column="4" Margin="16,0,0,0">
                                    <TextBlock Text="芯片ID"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#666666"
                                               Margin="0,0,0,2"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentDeviceInfo.ChipId}"
                                               FontSize="18"
                                               Foreground="#333333"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="--"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentDeviceInfo.ChipId}" Value="">
                                                        <Setter Property="Text" Value="--"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 分隔线 -->
                                <Rectangle Grid.Column="5" Width="1"
                                           Fill="#DDDDDD"
                                           VerticalAlignment="Stretch"
                                           Margin="0,2"/>

                                <!-- MAC地址 -->
                                <StackPanel Grid.Column="6" Margin="16,0,0,0">
                                    <TextBlock Text="WiFi MAC"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#666666"
                                               Margin="0,0,0,2"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentDeviceInfo.WifiMac}"
                                               FontSize="18"
                                               Foreground="#333333"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="--"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentDeviceInfo.WifiMac}" Value="">
                                                        <Setter Property="Text" Value="--"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 设备版本信息显示（目标版本+设备实际版本，VerificationType==VersionMatch 时显示，Legacy 产品使用） -->
                    <Border Grid.Row="3" 
                            Background="#F8F8F8" 
                            BorderBrush="#DDDDDD" 
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,4"
                            Margin="0,8,0,4"
                            HorizontalAlignment="Center"
                            Width="680"
                            Visibility="{Binding IsVersionInfoVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 目标版本 -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="目标版本" 
                                           FontSize="12" 
                                           FontWeight="Bold"
                                           Foreground="#666666"
                                           Margin="0,0,0,2"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ExpectedVersionDisplay}" 
                                           FontSize="18" 
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"/>
                            </StackPanel>
                            <!-- 分隔线 -->
                            <Rectangle Grid.Column="1" Width="1" 
                                       Fill="#DDDDDD" 
                                       VerticalAlignment="Stretch" 
                                       Margin="0,2"/>
                            <!-- 设备版本 -->
                            <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                <TextBlock Text="设备版本" 
                                           FontSize="12" 
                                           FontWeight="Bold"
                                           Foreground="#666666"
                                           Margin="0,0,0,2"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ActualDeviceVersionDisplay}" 
                                           FontSize="18" 
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Phase3：版本信息匹配对比（KM001 使用） -->
                    <Grid Grid.Row="4" Margin="0,8,0,4"
                          Visibility="{Binding IsPhase3Product, Converter={StaticResource BoolToVisibilityConverter}}">
                        <GroupBox Header="版本信息匹配对比">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>  <!-- 目标版本标签 -->
                                    <ColumnDefinition Width="*"/>     <!-- 目标版本输入 -->
                                    <ColumnDefinition Width="Auto"/>  <!-- 中间分隔线 -->
                                    <ColumnDefinition Width="Auto"/>  <!-- 设备版本标签 -->
                                    <ColumnDefinition Width="*"/>     <!-- 设备版本值 -->
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>    <!-- Row0: Android -->
                                    <RowDefinition Height="Auto"/>    <!-- Row1: 主板 -->
                                    <RowDefinition Height="Auto"/>    <!-- Row2: 充电板 -->
                                </Grid.RowDefinitions>

                                <!-- 中间竖直分隔线，贯穿三行 -->
                                <Rectangle Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                                           Width="1"
                                           Fill="#DDDDDD"
                                           Margin="12,2"
                                           VerticalAlignment="Stretch"/>

                                <!-- Row0: Android 版本 -->
                                <!-- 目标Android版本 -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding AndroidVersionLabel, StringFormat={}{0}：}"
                                           Margin="0,2,8,2"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Height="24"
                                         Margin="0,2,0,2"
                                         Text="{Binding ExpectedAndroidVersion, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsVersionInputEnabled}"/>

                                <!-- 设备Android版本 -->
                                <TextBlock Grid.Row="0" Grid.Column="3"
                                           Text="设备Android版本："
                                           Margin="12,2,8,2"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="4"
                                           Margin="0,2,0,2"
                                           Text="{Binding CurrentDeviceInfo.AndroidVersion}"/>

                                <!-- Row1: 主板版本 -->
                                <!-- 目标主板版本 -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{Binding BoardVersionLabel, StringFormat={}{0}：}"
                                           Margin="0,2,8,2"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Height="24"
                                         Margin="0,2,0,2"
                                         Text="{Binding ExpectedBoardVersion, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsVersionInputEnabled}"/>

                                <!-- 设备主板版本 -->
                                <TextBlock Grid.Row="1" Grid.Column="3"
                                           Text="设备主板版本："
                                           Margin="12,2,8,2"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="4"
                                           Margin="0,2,0,2"
                                           Text="{Binding CurrentDeviceInfo.BoardVersion}"/>

                                <!-- Row2: 充电板版本 -->
                                <!-- 目标充电板版本 -->
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="{Binding ChargeBoardVersionLabel, StringFormat={}{0}：}"
                                           Margin="0,2,8,2"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Height="24"
                                         Margin="0,2,0,2"
                                         Text="{Binding ExpectedChargeBoardVersion, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsVersionInputEnabled}"/>

                                <!-- 设备充电板版本 -->
                                <TextBlock Grid.Row="2" Grid.Column="3"
                                           Text="设备充电板版本："
                                           Margin="12,2,8,2"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="4"
                                           Margin="0,2,0,2"
                                           Text="{Binding CurrentDeviceInfo.ChargeBoardVersion}"/>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- 失败原因显示（仅FAIL时显示，区域更紧凑） -->
                    <Grid Grid.Row="6" MinHeight="40" Margin="0,6,0,6">
                        <Border Style="{StaticResource ErrorDetailPanelStyle}">
                            <TextBlock Text="{Binding FailReason}" Style="{StaticResource FailReasonStyle}"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. 辅助功能区（右侧：人工检验、自检、设备信息调试） -->
            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Top">
                <Button x:Name="StartVerifyButton" Content="人工检验" Width="120" Height="45" Margin="0,5"
                        Command="{Binding StartVerifyCommand}"
                        Click="StartVerifyButton_Click"
                        FontSize="14" FontWeight="Bold"/>
                <Button x:Name="SelfCheckButton" Content="自检" Width="120" Height="45" Margin="0,5"
                        Command="{Binding SelfCheckCommand}"
                        Click="SelfCheckButton_Click"
                        FontSize="14" FontWeight="Bold"/>
                <!-- 设备信息按钮：仅触发临时调试接口，不参与 SN 检验/自检/MES 流程 -->
                <Button x:Name="DeviceInfoButton" Content="设备信息" Width="120" Height="45" Margin="0,5"
                        Click="DeviceInfoButton_Click"
                        FontSize="14" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
